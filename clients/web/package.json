{
  "name": "@lychd/altar",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run licenses && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "licenses": "node ./scripts/generate-third-party-notices.mjs",
    "generate:api": "openapi-typescript ./openapi.json -o ./src/lib/api/openapi.d.ts",
    "verify": "npm run generate:api && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "mermaid": "11.17.2",
    "openapi-fetch": "0.17.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.13.3",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
