{
  "name": "@lychd/altar",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run licenses && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "licenses": "node ./scripts/generate-third-party-notices.mjs",
    "generate:api": "npm run generate --workspace @lychd/altar-openapi",
    "verify": "npm run generate:api && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@xyflow/svelte": "1.7.0",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "jsdom": "31.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "workspaces": [
    "tools/openapi"
  ]
}
