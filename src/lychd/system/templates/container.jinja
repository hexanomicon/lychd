[Unit]
Description={{ description }}
{% if pod_service %}
BindsTo={{ pod_service }}
{% endif %}
{% if binds_to %}
BindsTo={{ binds_to | join(' ') }}
{% endif %}
{% if wants %}
Wants={{ wants | join(' ') }}
{% endif %}
{% if requires %}
Requires={{ requires | join(' ') }}
{% endif %}
{% if after %}
After={{ after | join(' ') }}
{% endif %}
{% if conflicts %}
Conflicts={{ conflicts | join(' ') }}
{% endif %}

[Container]
{% if pod %}
Pod={{ pod }}
StartWithPod={{ start_with_pod | lower }}
{% endif %}
Image={{ image }}
ContainerName={{ container_name }}
{% if user %}
User={{ user }}
{% endif %}
{% if user_ns %}
UserNS={{ user_ns }}
{% endif %}
{% if run_init %}
RunInit=true
{% endif %}
{% if security_label_disable %}
SecurityLabelDisable=true
{% endif %}
{% if podman_args %}
PodmanArgs={{ podman_args | join(' ') }}
{% endif %}

# Devices
{% for dev in devices %}
AddDevice={{ dev }}
{% endfor %}

# Volumes
{% for vol in volumes %}
{% if vol.options %}
Volume={{ vol.host_path }}:{{ vol.container_path }}:{{ vol.options | join(',') }}
{% else %}
Volume={{ vol.host_path }}:{{ vol.container_path }}
{% endif %}
{% endfor %}

# Environment Variables
{% for key, value in env_vars.items() %}
Environment={{ quadlet_environment_assignment(key, value) }}
{% endfor %}

# Podman Secrets
{% for secret in secrets %}
Secret={{ secret }}
{% endfor %}

# Command / Entrypoint
{% if exec %}
Exec={{ exec }}
{% endif %}

[Service]
{% if service_type %}
Type={{ service_type }}
{% endif %}
{% if remain_after_exit %}
RemainAfterExit=true
{% endif %}
Restart={{ restart_policy | default('always') }}

[Install]
{% if wanted_by %}
WantedBy={{ wanted_by | join(' ') }}
{% endif %}
