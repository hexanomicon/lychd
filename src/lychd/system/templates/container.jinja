[Unit]
Description={{ description }}
{% if pod %}
BindsTo={{ pod }}
{% endif %}
{% for target in targets %}
PartOf=lychd-coven-{{ target }}.target
{% endfor %}
{% if wants %}
Wants={{ wants | join(' ') }}
{% endif %}
{% if after %}
After={{ after | join(' ') }}
{% endif %}
{% if conflicts %}
Conflicts={{ conflicts | join(' ') }}
{% endif %}

[Container]
{% if pod %}
Pod={{ pod }}
{% endif %}
Image={{ image }}
ContainerName={{ container_name }}
{% if user_ns %}
UserNS={{ user_ns }}
{% endif %}
{% if run_init %}
RunInit=true
{% endif %}
{% if security_label_disable %}
SecurityLabelDisable=true
{% endif %}
{% if podman_args %}
PodmanArgs={{ podman_args | join(' ') }}
{% endif %}

# Covens (Targets): {{ targets | join(', ') }}

# Devices
{% for dev in devices %}
AddDevice={{ dev }}
{% endfor %}

# Volumes
{% for vol in volumes %}
{% if vol.options %}
Volume={{ vol.host_path }}:{{ vol.container_path }}:{{ vol.options | join(',') }}
{% else %}
Volume={{ vol.host_path }}:{{ vol.container_path }}
{% endif %}
{% endfor %}

# Environment Variables
{% for key, value in env_vars.items() %}
Environment={{ key }}={{ value }}
{% endfor %}

# Podman Secrets
{% for secret in secrets %}
Secret={{ secret }}
{% endfor %}

# Command / Entrypoint
{% if exec %}
Exec={{ exec }}
{% endif %}

[Service]
Restart={{ restart_policy | default('always') }}

[Install]
{% if wanted_by %}
WantedBy={{ wanted_by | join(' ') }}
{% endif %}
{% for target in targets %}
WantedBy=lychd-coven-{{ target }}.target
{% endfor %}
