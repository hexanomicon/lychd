{# A settled agent turn. `turn` is a BridgeTurn. When `oob=True` this replaces the
   streaming slot in place (SSE `done` event, §7.2). The internal turn state is
   mapped to the frozen run `data-state` vocabulary by the `run_data_state` filter. #}
{% set ds = turn.state | run_data_state %}
<article id="run-{{ turn.run_id }}" class="turn turn--agent"
         data-fragment="bridge.turn" data-state="{{ ds }}" data-run-id="{{ turn.run_id }}"
         {% if oob %}hx-swap-oob="outerHTML:#run-{{ turn.run_id }}"{% endif %}>
  <div class="turn__meta">
    <span class="who">The First One</span>
    {% if ds == 'failed' %}
    <span class="chip" data-state="failed">faulted</span>
    {% else %}
    <span class="chip" data-state="done">settled</span>
    {% endif %}
    {% if turn.run_id %}<span class="glyph">run {{ turn.run_id[:8] }}</span>{% endif %}
  </div>
  <div class="turn__body">{{ turn.content }}</div>
  {% if ds == 'failed' and turn.run_id %}
  <div class="turn__fault">run {{ turn.run_id[:8] }} · the summoning faltered</div>
  {% endif %}
</article>
