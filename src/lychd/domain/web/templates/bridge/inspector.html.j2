{# The right contextual inspector (route 8). A fragment: it replaces its own
   placeholder wholesale. The Stable Floor panel shows the keyed-block skeleton
   the CAG assembles per run; live digests appear only while a run is in flight. #}
<aside class="bridge-inspector" data-fragment="bridge.inspector" data-state="rendered"
       data-session-id="{{ session_id }}">
  <div class="panel">
    <div class="panel-head"><span class="rune-head">Session</span></div>
    <dl class="kv">
      <dt>session</dt><dd class="glyph">{{ session_id[:12] if session_id else '—' }}</dd>
      <dt>title</dt><dd>{{ session.title if session else 'New Communion' }}</dd>
      <dt>turns</dt><dd class="glyph">{{ session.turns | length if session else 0 }}</dd>
      <dt>consents</dt><dd>{{ pending }} pending</dd>
      <dt>meridian</dt><dd>after layer 4 · pinned</dd>
    </dl>
  </div>
  <div class="panel">
    <div class="panel-head"><span class="rune-head">Stable Floor</span></div>
    <div class="floor" data-fragment="bridge.inspector.floor" data-state="rendered">
      <div class="block"><span class="layer">1</span><span class="k">identity:the-first-one:v1</span><span class="h">pinned</span></div>
      <div class="block stub"><span class="layer">2</span><span class="k">codex:none:v0</span><span class="h">stub</span></div>
      <div class="block"><span class="layer">3</span><span class="k">env:{{ session_id[:6] if session_id else 'none' }}:0</span><span class="h">epoch 0</span></div>
      <div class="block stub"><span class="layer">4</span><span class="k">karma:{{ session_id[:6] if session_id else 'none' }}:pinned</span><span class="h">stub</span></div>
      <div class="block volatile"><span class="layer">5</span><span class="k">state · window</span><span class="h">vṛtti</span></div>
      <div class="block volatile"><span class="layer">6</span><span class="k">query</span><span class="h">vṛtti</span></div>
      <div class="floor-digest"><span>prefix digest</span><b>live only</b></div>
    </div>
  </div>
</aside>
