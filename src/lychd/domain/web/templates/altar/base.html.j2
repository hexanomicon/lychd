<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{ csrf_token }}">
  <title>{% block title %}LychD — The Altar{% endblock %}</title>
  {{ vite_hmr() }}
  {{ vite('resources/main.js') }}
</head>
<body hx-ext="sse" hx-headers='{"x-csrftoken":"{{ csrf_token }}"}'>

  {# ══ Shell: top bar + instrument map ══════════════════════════════ #}
  <header class="topbar">
    <div class="brand">
      <span class="mark">◈</span>
      <span class="name rune-head">LychD</span>
      <span class="sub">The Altar</span>
    </div>

    <nav class="instruments" aria-label="Instruments" hx-boost="true">
      {% include 'altar/partials/nav.html.j2' %}
    </nav>

    <div class="spacer"></div>

    {% include 'altar/partials/consent_sigil.html.j2' %}
    <span class="sigil-identity">Sigil <b>{{ sigil_name | default('Magus') }}</b></span>
  </header>

  <main id="altar-main">
    {% block main %}{% endblock %}
  </main>

  {# ══ Omen toast stack — disconnect / error feedback (§6.3) ═════════ #}
  <div class="omen-stack" role="status" aria-live="polite"
       x-data="omens" @altar:omen.window="add($event.detail.text, $event.detail.fault)">
    <template x-for="omen in items" :key="omen.id">
      <div class="omen" :data-state="omen.fault ? 'fault' : 'info'">
        <span x-text="omen.text"></span>
        <button class="dismiss" type="button" @click="dismiss(omen.id)" aria-label="Dismiss">✕</button>
      </div>
    </template>
  </div>

</body>
</html>
