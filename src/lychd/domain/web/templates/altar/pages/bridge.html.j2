{% extends 'altar/base.html.j2' %}
{% set active = 'bridge' %}
{% block title %}Bridge — LychD{% endblock %}
{% block main %}
<div class="instrument-deck" aria-label="Bridge">

  {# ── session rail ────────────────────────────────────────────────── #}
  <aside class="bridge-rail">
    <button class="rune-btn new-seance" type="button"
            hx-post="{{ route_path('bridge:create') }}" hx-swap="none">✦ &nbsp;New Séance</button>
    <div class="divider">◆</div>
    {% for item in sessions %}
      {% with current = (session and item.id == session.id) %}
        {% include 'bridge/session_rail.html.j2' %}
      {% endwith %}
    {% else %}
      <p class="glyph rail-empty">No séance yet — open one to speak.</p>
    {% endfor %}
  </aside>

  {# ── thread ──────────────────────────────────────────────────────── #}
  <div class="bridge-thread">
    {% include 'bridge/thread.html.j2' %}

    {% if session %}
    <form class="composer" id="bridge-composer"
          hx-post="{{ route_path('bridge:send', session_id=session.id) }}"
          hx-target="#bridge-thread" hx-swap="beforeend show:bottom"
          hx-disabled-elt="find button" hx-indicator="#bridge-composer .thinking-rune"
          x-data="composer" @htmx:after-request="clear()">
      <textarea name="prompt" required rows="2" placeholder="Speak into the Bridge…"
                @keydown.enter="submit($event)"></textarea>
      <button class="rune-btn" type="submit">Offer&ensp;<span class="thinking-rune htmx-indicator">◆</span></button>
    </form>
    {% endif %}
  </div>

  {# ── contextual inspector ────────────────────────────────────────── #}
  {% if session %}
  <div hx-get="{{ route_path('bridge:inspector', session_id=session.id) }}"
       hx-trigger="load" hx-swap="outerHTML"></div>
  {% else %}
  <aside class="bridge-inspector"></aside>
  {% endif %}
</div>
{% endblock %}
