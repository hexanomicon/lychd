{# The Loom rail: woven patterns from WORKFLOWS. Each item swaps its graph into
   #loom-canvas and pushes the honest URL. `selected` names the active pattern. #}
<div class="divider">PATTERNS ◆ WOVEN</div>
{% for wf in workflows %}
{% set wf_path = route_path('loom:view', workflow=wf.name) %}
<a class="pattern{% if selected == wf.name %} current{% endif %}"
   hx-get="{{ wf_path }}" hx-target="#loom-canvas" hx-swap="innerHTML"
   hx-push-url="{{ wf_path }}"
   href="{{ wf_path }}"
   data-fragment="loom.gallery-item" data-workflow="{{ wf.name }}">
  <span class="t">{{ wf.title }}</span>
  <span class="m glyph">{{ wf.graph.get_nodes() | length }} nodes · {{ wf.trigger.hint }}</span>
</a>
{% else %}
<p class="glyph rail-empty">No patterns woven.</p>
{% endfor %}
