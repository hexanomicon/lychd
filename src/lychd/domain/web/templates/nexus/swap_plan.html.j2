{# The transition-plan dry-run drawer (§7.5). `plan` is a TransitionPlan; `target`
   is the requested capability key. Swapped into #nexus-plan (innerHTML). #}
<div data-fragment="nexus.plan" data-state="rendered">
  <div class="panel-head"><span class="rune-head">Transition Scrying</span></div>
  <div class="plan-verdict">✦ {{ plan.action_type }}
    {% if plan.action_type == 'HARD_SWAP' %}— the substrate must be reclaimed
    {% elif plan.action_type == 'SOFT_SWAP' %}— a warm reshuffle
    {% else %}— nothing to reclaim{% endif %}
  </div>
  <div class="plan-list">
    <div class="row"><span class="l">target</span><span class="v launch">{{ target }}</span></div>
    <div class="row"><span class="l">metabolic cost</span><span class="v">{{ plan.total_metabolic_cost }}</span></div>
    {% for evictee in plan.evict_coven_ids %}
    <div class="row"><span class="l">evict</span><span class="v evict">{{ evictee }}</span></div>
    {% endfor %}
    {% for launch in plan.launch_coven_ids %}
    <div class="row"><span class="l">launch</span><span class="v launch">{{ launch }}</span></div>
    {% endfor %}
    <div class="row"><span class="l">drain</span><span class="v">pause queues → soft stop → await</span></div>
  </div>
  {% if plan.action_type != 'NO_OP' %}
  <form class="plan-act" hx-post="/nexus/swap" hx-target="#nexus-plan" hx-swap="innerHTML"
        hx-confirm="Consecrate this coven swap? Active covens will be drained.">
    <input type="hidden" name="target" value="{{ target }}">
    <button class="rune-btn rune-btn--frost" type="submit">❄ Consecrate the Swap</button>
    <span class="warn">Active leases are honoured through the drain; outstanding grants are
      revoked at the boundary. Any live Bridge run enters Live Stasis.</span>
  </form>
  {% else %}
  <div class="plan-act"><span class="warn">The capability is already warm — no transition needed.</span></div>
  {% endif %}
</div>
