{# The coven board fragment: soulstone covens plus a Portals column. `board` is a
   NexusBoard view-model. Swapped into #nexus-board (innerHTML). #}
<div data-fragment="nexus.board" data-state="rendered">
  <div class="coven-grid">
    {% for coven_name, rows in board.covens %}
      {% with name = coven_name, is_portal = False %}
        {% include 'nexus/coven_card.html.j2' %}
      {% endwith %}
    {% endfor %}
    {% if board.portals %}
      {% with name = 'Portals', rows = board.portals, is_portal = True %}
        {% include 'nexus/coven_card.html.j2' %}
      {% endwith %}
    {% endif %}
  </div>
</div>
