[
  {
    "dump": {
      "description": "The Sepulcher (LychD Pod)",
      "pod_name": "lychd",
      "publish_ports": [
        "7134:8000",
        "5432:5432",
        "6006:6006",
        "4317:4317"
      ],
      "wanted_by": [
        "default.target"
      ]
    },
    "id": "lychd",
    "type": "QuadletPod"
  },
  {
    "dump": {
      "after": [
        "lychd-phylactery.service"
      ],
      "conflicts": [],
      "container_name": "lychd-vessel",
      "description": "The Vessel (LychD Application Kernel)",
      "devices": [],
      "env_vars": {
        "APP__SECRET_KEY_FILE": "/run/secrets/${APP_SECRET}",
        "DB__HOST": "localhost",
        "DB__PASSWORD_FILE": "/run/secrets/${DB_SECRET}",
        "DB__PORT": "5432"
      },
      "exec": null,
      "image": "${APP_IMAGE}",
      "pod": "lychd.pod",
      "podman_args": [
        "--replace"
      ],
      "restart_policy": "always",
      "run_init": true,
      "secrets": [
        "${APP_SECRET}",
        "${DB_SECRET}",
        "openai_api_key"
      ],
      "security_label_disable": false,
      "targets": [],
      "user_ns": "keep-id",
      "volumes": [
        {
          "container_path": "${PATH_CODEX_ROOT}",
          "host_path": "${PATH_CODEX_ROOT}",
          "mirror": true,
          "options": [
            "ro",
            "Z"
          ]
        },
        {
          "container_path": "${PATH_CRYPT_ROOT}",
          "host_path": "${PATH_CRYPT_ROOT}",
          "mirror": true,
          "options": [
            "rw",
            "Z"
          ]
        },
        {
          "container_path": "${PATH_CORE_DIR}",
          "host_path": "${PATH_CORE_DIR}",
          "mirror": true,
          "options": [
            "ro",
            "Z"
          ]
        },
        {
          "container_path": "${PATH_EXTENSIONS_DIR}",
          "host_path": "${PATH_EXTENSIONS_DIR}",
          "mirror": true,
          "options": [
            "ro",
            "Z"
          ]
        }
      ],
      "wanted_by": [
        "default.target"
      ],
      "wants": [
        "lychd-phylactery.service"
      ]
    },
    "id": "lychd-vessel",
    "type": "QuadletContainer"
  },
