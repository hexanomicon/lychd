# Project-owned standard-tools transport; immutable deployment uses its built digest.
FROM docker.io/library/debian@sha256:c67e92c8099ba22853ab4cfda7cfb494d253d6012ca82dee98ba8976772af018
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 wireguard-tools iproute2 nftables openssh-server passwd \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* \
    && groupadd --system tether \
    && useradd --system --gid tether --home-dir /nonexistent --shell /usr/sbin/nologin --password '*' tether \
    && mkdir -p /usr/libexec /etc/lychd-tether /var/empty/sshd \
    && chmod 0755 /var/empty/sshd /etc/lychd-tether
COPY src/lychd/system/services/tether/runtime.py /usr/libexec/lychd-tether-runtime
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/lychd-tether/
RUN chmod 0555 /usr/libexec/lychd-tether-runtime \
    && test -x /usr/sbin/ip && test -x /usr/sbin/nft \
    && test -x /usr/bin/wg && test -x /usr/sbin/sshd
USER 0
CMD ["/usr/bin/python3", "/usr/libexec/lychd-tether-runtime", "wireguard"]
